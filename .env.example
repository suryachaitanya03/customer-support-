# Local development defaults. Never put real credentials in this file.
HOST=127.0.0.1
PORT=8000
APP_ENV=development

# Optional sign-in. Replace with a private, long random password before use.
# SUPPORT_USERS={"agent":{"password":"replace-this","role":"agent"}}

# Optional OpenAI-compatible model provider.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
